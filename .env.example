# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox

# Required server-only secrets, each independently generated with >=32 characters.
# Set these as encrypted secrets for BOTH Preview and Production in Pages settings.
# Never prefix with VITE_ or commit real values. Blank values intentionally disable access.
DSK_SERVER_SECRET=
ADMIN_SECRET=

# Optional Email / Webhook Notifications
# Optional server-only administrator Pro activation (disabled when blank).
# Configure independently for Pages Preview/Production; never prefix with VITE_.
# Generate a fresh key: DSK-ADMIN- followed by 64 random hexadecimal characters.
# See docs/admin-pro-key-deployment.md. Do not reuse public preview credentials.
DSK_ADMIN_PRO_KEY=
DSK_ADMIN_PRO_ORIGINS=

# RESEND_API_KEY=re_xxxxxxxxxxxx
# NOTIFICATION_EMAIL=your_email@example.com
# NOTIFICATION_WEBHOOK=https://...
