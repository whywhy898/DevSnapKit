{
  "name": "shotcraft-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:security": "node --test tests/security*.test.mjs",
    "test:paypal": "node --test tests/paypal-webhook.test.mjs tests/paypal-recovery.test.mjs",
    "test:paypal:browser": "node --test tests/paypal-browser.test.mjs",
    "test:poster:v1": "node --test tests/poster-v1.test.mjs tests/poster-m1.test.mjs",
    "test:poster:v1:browser": "node tests/run-poster-browser.mjs",
    "test:canvas-text:v1": "node --test tests/canvas-text-v1.test.mjs tests/canvas-text-history-hook.test.mjs tests/canvas-text-v1-preparation.test.mjs tests/canvas-text-geometry.test.mjs tests/canvas-text-output.test.mjs",
    "test:canvas-text:v1:browser": "node tests/run-canvas-text-browser.mjs",
    "test:text:v1": "npm run test:canvas-text:v1",
    "test:text:v1:browser": "npm run test:canvas-text:v1:browser"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.2",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
